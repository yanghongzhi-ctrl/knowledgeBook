      ],
      "rows": [
        {
          "特征名称": "构件与参数化建模",
          "英文术语": "Component & Parametric Modeling",
          "特征解释与意义": "BIM模型由具有语义的构件组成，参数控制模型行为，几何与信息高度集成，实现动态更新与模型驱动设计。"
        },
        {
          "特征名称": "信息集成与互操作",
          "英文术语": "Information Integration & Interoperability",
          "特征解释与意义": "结合几何、材料、工程量、运维等多维信息，基于IFC、LandXML等标准格式实现跨平台数据交互与语义一致性。"
        },
        {
          "特征名称": "协同与跨专业流程",
          "英文术语": "Collaborative& Interdisciplinary Workflow",
          "特征解释与意义": "各专业基于统一平台协同建模，实现模型在规划、设计、施工、运维各阶段的数据连续性与逻辑一致性。"
        },
        {
          "特征名称": "4D/5D集成",
          "英文术语": "4D/5D Integration",
          "特征解释与意义": "支持施工进度模拟（4D）与工程造价分析（5D），提升项目计划管理能力，促进资源优化配置。"
        },
        {
          "特征名称": "可视化与仿真",
          "英文术语": "Visualization & Simulation",
          "特征解释与意义": "提供三维表达、安全评价、交通仿真等功能，增强沟通、决策与优化方案设计的技术支持。"
        },
        {
          "特征名称": "平台化集成",
          "英文术语": "Platform-based Integration",
          "特征解释与意义": "可与GIS、CIM、运维管理系统等集成，构建数字孪生道路和全生命周期管理体系，支持多源信息的融合与调度。"
        },
        {
          "特征名称": "全生命周期理念",
          "英文术语": "Lifecycle-oriented Philosophy",
          "特征解释与意义": "BIM强调从设计初期即构建可传承的信息资产，支持道路基础设施的全生命周期管理。"
        }
      ],
