          },
          {
            "chunk_id": "ch11_src_124",
            "title": "虚拟驾驶仿真与安全评价 为系统评估设计方案的行车安全性与舒适性，数字孪生支持在高保真虚拟环境中开展虚拟试驾，实现安全风险的前置识别与验证。 1.三维视距连续性检验",
            "confidence": "low",
            "word_status": "auto_anchor_missing_or_weak",
            "alignment_status": "missing",
            "boundary_type": "weak_or_missing_anchor",
